# Studio Complex · configuración del servidor (LiteSpeed/Apache, Turbonube)

# Sin listado de carpetas (antes mostraba "Index of /")
Options -Indexes

# Página de error propia
ErrorDocument 404 /error.html

RewriteEngine On
# Todo por HTTPS y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://studiocomplex.com.ar%{REQUEST_URI} [L,R=301]

# Los CSS y JS llevan ?v= en cada publicación (tools/version-assets.py),
# así que se pueden guardar mucho tiempo. El HTML se revisa siempre.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
